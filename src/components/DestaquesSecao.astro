---
import { destaquesPublicados } from '../lib/conteudo';
import Imagem from './Imagem.astro';
import Secao from './Secao.astro';

const destaques = await destaquesPublicados();
const itens = destaques?.itens ?? [];
---

{
  itens.length > 0 && (
    <Secao id="destaques" titulo={destaques?.titulo ?? 'Destaques'}>
      <ul class="grid gap-6 md:grid-cols-3">
        {itens.map((item) => {
          const cartao = (
            <div class="overflow-hidden rounded-xl border border-borda bg-superficie transition group-hover:border-acento">
              <div class="aspect-video">
                <Imagem src={item.imagem} alt={item.titulo} classe="size-full" emoji="✨" />
              </div>
              <div class="p-5">
                {item.tag && (
                  <span class="rounded-full bg-fundo px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-acento">
                    {item.tag}
                  </span>
                )}
                <h3 class="mt-2 font-black leading-snug group-hover:text-acento">{item.titulo}</h3>
                <p class="mt-2 line-clamp-3 text-sm text-suave">{item.resumo}</p>
              </div>
            </div>
          );
          return (
            <li class="group">
              {item.href ? (
                <a href={item.href} class="block">
                  {cartao}
                </a>
              ) : (
                cartao
              )}
            </li>
          );
        })}
      </ul>
    </Secao>
  )
}
