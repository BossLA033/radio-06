---
import { eventosPublicados } from '../lib/conteudo';
import { formatarDataLonga } from '../lib/formatos';
import Imagem from './Imagem.astro';
import Secao from './Secao.astro';

const agora = Date.now();
const futuros = (await eventosPublicados()).filter((evento) => evento.data.data.valueOf() >= agora);
const passados = (await eventosPublicados()).filter((evento) => evento.data.data.valueOf() < agora);
const lista = [...futuros, ...passados].slice(0, 3);
---

{
  lista.length > 0 && (
    <Secao id="concertos" titulo="CONCERTOS" href="/concertos/" rotulo="VER MAIS">
      <ul class="grid gap-6 md:grid-cols-3">
        {lista.map((evento) => (
          <li class="item">
            <div class="thumb">
              <Imagem src={evento.data.imagem} alt={evento.data.titulo} classe="size-full absolute inset-0" emoji="🎫" />
            </div>
            <div class="txt">
              <span class="text-destaque">{formatarDataLonga(evento.data.data)}</span>
              <div class="mt-1 font-bold">{evento.data.titulo}</div>
              <div class="text-suave">{evento.data.local}</div>
              <p class="mt-1 line-clamp-3 text-suave">{evento.data.descricao}</p>
            </div>
          </li>
        ))}
      </ul>
    </Secao>
  )
}
