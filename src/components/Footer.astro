---
import { definicoes } from '../lib/conteudo';

const d = await definicoes();
const ano = new Date().getFullYear();

const colunas = [
  {
    titulo: 'Ouvir',
    ligações: [
      { href: '/programacao/', rotulo: 'Programação' },
      { href: '/programas/', rotulo: 'Programas' },
      { href: '/podcasts/', rotulo: 'Podcasts' },
      { href: '/videos/', rotulo: 'Vídeos' },
    ],
  },
  {
    titulo: 'Descobrir',
    ligações: [
      { href: '/noticias/', rotulo: 'Notícias' },
      { href: '/eventos/', rotulo: 'Eventos' },
      { href: '/apresentadores/', rotulo: 'Apresentadores' },
      { href: '/sobre/', rotulo: 'Sobre' },
    ],
  },
];
---

<footer class="mt-20 border-t border-borda bg-superficie">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-4">
    <div>
      <p class="text-lg font-black">{d.nome}</p>
      <p class="mt-1 text-sm text-suave">{d.slogan}</p>
      <p class="mt-3 text-sm font-semibold text-destaque">{d.frequencia}</p>
      {
        d.morada && (
          <p class="mt-3 text-sm text-suave">{d.morada}</p>
        )
      }
      <a href={`mailto:${d.email}`} class="mt-2 block text-sm text-suave hover:text-acento">
        {d.email}
      </a>
    </div>

    {
      colunas.map((coluna) => (
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-suave">{coluna.titulo}</p>
          <ul class="mt-3 space-y-2 text-sm">
            {coluna.ligações.map((item) => (
              <li>
                <a href={item.href} class="hover:text-acento">
                  {item.rotulo}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-suave">Redes</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          d.redes.length > 0 ? (
            d.redes.map((rede) => (
              <li>
                <a href={rede.url} class="hover:text-acento" rel="noopener noreferrer" target="_blank">
                  {rede.nome}
                </a>
              </li>
            ))
          ) : (
            <li class="text-suave">A definir no painel</li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-borda">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-suave">
      © {ano} {d.nome} — {d.slogan}. Todos os direitos reservados.
    </p>
  </div>
</footer>
