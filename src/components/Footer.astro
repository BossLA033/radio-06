---
import { definicoes } from '../lib/conteudo';

const d = await definicoes();
const ano = new Date().getFullYear();

const navegação = [
  { href: '/noticias/', rotulo: 'Notícias' },
  { href: '/podcasts/', rotulo: 'Podcasts' },
  { href: '/videos/', rotulo: 'Vídeos' },
  { href: '/programas/', rotulo: 'Programas' },
  { href: '/programacao/', rotulo: 'Programação' },
  { href: '/concertos/', rotulo: 'Concertos' },
];

const legais = [
  { href: '/sobre/', rotulo: 'Frequências' },
  { href: '/contactos/', rotulo: 'Feedback' },
  { href: '/sobre/', rotulo: 'Termos e condições' },
  { href: '/sobre/', rotulo: 'Política de privacidade' },
  { href: '/contactos/', rotulo: 'Publicidade' },
];

const irmandades = ['RÁDIO X', 'MÚSICA X', 'CIDADE FM', 'SMOOTH X', 'BOOM X', 'AUDIO X'];
---

<footer class="mt-10 border-t border-borda bg-[#0d0d0d]">
  <div class="foot-main">
    <div>
      <a href="/" class="wordmark" style="font-size:32px">{d.nome}</a>
      <p class="tagline">{d.slogan} — {d.frequencia}.</p>
      {d.morada && <p class="tagline">{d.morada}</p>}
      <a class="tagline" href={`mailto:${d.email}`}>{d.email}</a>
      {
        d.redes.length > 0 && (
          <div class="mt-3 flex gap-4">
            {d.redes.map((rede) => (
              <a href={rede.url} rel="noopener noreferrer" target="_blank">
                {rede.nome}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div>
      <h5>Navegação</h5>
      {navegação.map((item) => <a href={item.href}>{item.rotulo}</a>)}
    </div>

    <div>
      <h5>Segue-nos</h5>
      {d.redes.length > 0
        ? d.redes.map((rede) => (
            <a href={rede.url} rel="noopener noreferrer" target="_blank">
              {rede.nome}
            </a>
          ))
        : <p>Redes a definir no painel</p>}
      <a href="/apresentadores/">A equipa</a>
      <a href="/sobre/">Sobre nós</a>
    </div>
  </div>

  <div class="sisters">
    {irmandades.map((nome) => <span>{nome}</span>)}
  </div>

  <div class="foot-links">
    {legais.map((item) => <a href={item.href}>{item.rotulo}</a>)}
  </div>

  <p class="copy">
    © {ano} {d.nome} {d.frequencia}. Todos os direitos reservados.<br />
    Qualquer reprodução sem consentimento é expressamente proibida.
  </p>
</footer>
