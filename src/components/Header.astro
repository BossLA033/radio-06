---
import { definicoes } from '../lib/conteudo';

const d = await definicoes();
const actual = Astro.url.pathname.replace(/\/$/, '') || '/';

const ligações = [
  { href: '/#passou', rotulo: 'OUVIR' },
  { href: '/#podcasts', rotulo: 'PODCASTS' },
  { href: '/#passou', rotulo: 'PASSOU' },
  { href: '/#videos', rotulo: 'VÍDEOS' },
  { href: '/#programas', rotulo: 'PROGRAMAS' },
  { href: '/#destaques', rotulo: 'DESTAQUES' },
  { href: '/#tnt', rotulo: 'TOP X' },
  { href: '/#noticias', rotulo: 'NOTÍCIAS' },
  { href: '/#equipa', rotulo: 'SOMOS NÓS' },
];

const activo = (href: string) => href.startsWith('/#') ? false : actual === href.replace(/\/$/, '');
---

<header class="sticky top-0 z-[200] border-b border-borda bg-fundo">
  <div class="flex flex-wrap items-center gap-7 px-6 py-2.5">
    <a href="/" class="flex flex-col" aria-label={`${d.nome} — página inicial`}>
      <span class="wordmark">{d.nome}</span>
      <span class="freq">{d.frequencia}</span>
    </a>

    <nav aria-label="Navegação principal" class="nav-topo ml-auto hidden md:flex flex-wrap gap-6">
      {
        ligações.map((item) => (
          <a href={item.href} class:list={[activo(item.href) && 'activo']}>
            {item.rotulo}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-3 text-suave md:ml-0">
      <a href="/contactos/" aria-label="Contactos">✉</a>
      <a href="/sobre/" aria-label="Sobre a rádio">◎</a>
    </div>

    <button
      type="button"
      id="menu-botao"
      class="border-none bg-transparent text-2xl text-texto md:hidden"
      aria-expanded="false"
      aria-controls="menu-movel"
      aria-label="Abrir menu"
    >
      ☰
    </button>
  </div>

  <nav
    id="menu-movel"
    aria-label="Navegação móvel"
    class="hidden border-t border-borda bg-superficie px-6 py-4 md:hidden"
  >
    <ul class="flex flex-col gap-3 text-sm font-extrabold tracking-widest">
      {
        ligações.map((item) => (
          <li>
            <a href={item.href} class="block py-1">
              {item.rotulo}
            </a>
          </li>
        ))
      }
      <li><a href="/programacao/" class="block py-1">PROGRAMAÇÃO</a></li>
      <li><a href="/contactos/" class="block py-1">CONTACTOS</a></li>
    </ul>
  </nav>
</header>

<script>
  function montarMenu() {
    const botao = document.getElementById('menu-botao');
    const menu = document.getElementById('menu-movel');
    if (!botao || !menu || botao.dataset.ligado === '1') return;
    botao.dataset.ligado = '1';
    botao.addEventListener('click', () => {
      const aberto = botao.getAttribute('aria-expanded') === 'true';
      botao.setAttribute('aria-expanded', String(!aberto));
      botao.setAttribute('aria-label', aberto ? 'Abrir menu' : 'Fechar menu');
      menu.classList.toggle('hidden', aberto);
    });
  }

  document.addEventListener('astro:page-load', montarMenu);
</script>
