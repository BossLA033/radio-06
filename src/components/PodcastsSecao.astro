---
import { podcastsPublicos } from '../lib/conteudo';
import { formatarData } from '../lib/formatos';
import Imagem from './Imagem.astro';
import Secao from './Secao.astro';

const series = (await podcastsPublicos()).slice(0, 4);
---

{
  series.length > 0 && (
    <Secao id="podcasts" titulo="Podcasts" href="/podcasts/" rotulo="Todos os podcasts">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {series.map(({ serie, episodios }) => {
          const ultimo = episodios[0];
          return (
            <li class="rounded-xl border border-borda bg-superficie p-5 transition hover:border-acento">
              <div class="mb-4 aspect-square overflow-hidden rounded-lg bg-fundo">
                <Imagem src={serie.data.imagem} alt={serie.data.titulo} classe="size-full" emoji="🎧" />
              </div>
              <h3 class="font-black leading-snug">{serie.data.titulo}</h3>
              <p class="mt-1 text-xs text-suave">
                {episodios.length} {episodios.length === 1 ? 'episódio' : 'episódios'} · {formatarData(ultimo.data)}
              </p>
              <p class="mt-2 line-clamp-2 text-sm text-suave">{serie.data.descricao}</p>
              <a href={`/podcasts/${serie.id}/`} class="mt-3 inline-block text-sm font-semibold text-acento">
                Ouvir →
              </a>
            </li>
          );
        })}
      </ul>
    </Secao>
  )
}
