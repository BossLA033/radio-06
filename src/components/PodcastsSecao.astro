---
import { podcastsPublicos } from '../lib/conteudo';
import { formatarData } from '../lib/formatos';
import Imagem from './Imagem.astro';
import Carrossel from './Carrossel.astro';
import Secao from './Secao.astro';

const series = (await podcastsPublicos()).slice(0, 4);
---

{
  series.length > 0 && (
    <Secao id="podcasts" titulo="PODCASTS" href="/podcasts/" rotulo="VER MAIS">
      <Carrossel id="podCar">
        {series.map(({ serie, episodios }) => {
          const ultimo = episodios[0];
          return (
            <li class="item">
              <a href={`/podcasts/${serie.id}/`} class="block">
                <div class="thumb">
                  <Imagem src={serie.data.imagem} alt={serie.data.titulo} classe="size-full absolute inset-0" emoji="🎙️" />
                  <span class="play-badge">▶</span>
                </div>
                <div class="txt">
                  <div class="font-bold">{serie.data.titulo}</div>
                  <div class="mt-1 text-suave" style="font-size:11px">
                    {episodios.length} {episodios.length === 1 ? 'episódio' : 'episódios'} · {formatarData(ultimo.data)}
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </Carrossel>
    </Secao>
  )
}
