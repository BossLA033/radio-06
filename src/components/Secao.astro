---
interface Props {
  id: string;
  titulo: string;
  href?: string;
  rotulo?: string;
}

const { id, titulo, href, rotulo = 'VER MAIS' } = Astro.props;
---

<section id={id} class="section">
  <div class="wrap">
    <div class="sec-head">
      <h2>{titulo}</h2>
      {href && <a href={href} class="vermais">{rotulo}</a>}
    </div>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
