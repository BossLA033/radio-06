---
import { topxPublicado } from '../lib/conteudo';
import Imagem from './Imagem.astro';
import Secao from './Secao.astro';

const topx = await topxPublicado();
const itens = [...(topx?.itens ?? [])]
  .filter((item) => !item.href || item.href.length > 0)
  .sort((a, b) => a.pos - b.pos);
const meio = Math.ceil(itens.length / 2);
const colunas = [itens.slice(0, meio), itens.slice(meio)];
---

{
  itens.length > 0 && (
    <Secao id="tnt" titulo="TOP X">
      <div class="tnt-grid">
        {colunas.map((coluna) => (
          <div class="tnt-col">
            {coluna.map((item) => {
              const conteudo = (
                <>
                  <span class="tnt-pos">{item.pos}</span>
                  <div class="cov">
                    <Imagem src={item.imagem} alt="" classe="size-full" emoji="⭐" />
                  </div>
                  <div class="inf">
                    <b>{item.texto}</b>
                  </div>
                </>
              );
              return item.href ? (
                <a href={item.href} class="tnt-item">
                  {conteudo}
                </a>
              ) : (
                <div class="tnt-item">{conteudo}</div>
              );
            })}
          </div>
        ))}
        <div class="side-ad">ESPAÇO PUBLICITÁRIO<br><span style="font-size:12px;font-weight:400">300×600</span></div>
      </div>
    </Secao>
  )
}
