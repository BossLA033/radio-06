---
import { topxPublicado } from '../lib/conteudo';
import Imagem from './Imagem.astro';
import Secao from './Secao.astro';

const topx = await topxPublicado();
const itens = [...(topx?.itens ?? [])]
  .filter((item) => !item.href || item.href.length > 0)
  .sort((a, b) => a.pos - b.pos);
---

{
  itens.length > 0 && (
    <Secao id="tnt" titulo={topx?.titulo ?? 'Top X'}>
      <ol class="divide-y divide-borda rounded-xl border border-borda bg-superficie">
        {itens.map((item) => {
          const conteudo = (
            <div class="flex items-center gap-4 p-4">
              <span class="w-10 shrink-0 text-center text-2xl font-black text-acento">{item.pos}</span>
              <div class="size-14 shrink-0 overflow-hidden rounded-lg bg-fundo">
                <Imagem src={item.imagem} alt="" classe="size-full" emoji="⭐" />
              </div>
              <span class="font-semibold">{item.texto}</span>
            </div>
          );
          return (
            <li>
              {item.href ? (
                <a href={item.href} class="block transition hover:bg-fundo">
                  {conteudo}
                </a>
              ) : (
                conteudo
              )}
            </li>
          );
        })}
      </ol>
    </Secao>
  )
}
