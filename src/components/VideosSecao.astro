---
import type { CollectionEntry } from 'astro:content';
import { videosPublicados } from '../lib/conteudo';
import Imagem from './Imagem.astro';
import Carrossel from './Carrossel.astro';
import Secao from './Secao.astro';

function thumbDoVideo(video: CollectionEntry<'videos'>) {
  if (video.data.thumb) return video.data.thumb;
  if (video.data.origem === 'youtube') {
    const id = video.data.url.match(/(?:v=|youtu\.be\/)([\w-]{11})/)?.[1];
    if (id) return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
  }
  return undefined;
}

const videos = (await videosPublicados()).slice(0, 6);
---

{
  videos.length > 0 && (
    <Secao id="videos" titulo="VÍDEOS" href="/videos/" rotulo="VER MAIS">
      <Carrossel id="vidCar">
        {videos.map((video) => (
          <li class="item">
            <a href={video.data.url} target="_blank" rel="noopener noreferrer" class="block">
              <div class="thumb">
                <Imagem src={thumbDoVideo(video)} alt={video.data.titulo} classe="size-full absolute inset-0" emoji="🎬" />
                <span class="play-badge">▶</span>
              </div>
              <div class="txt">{video.data.titulo}</div>
            </a>
          </li>
        ))}
      </Carrossel>
    </Secao>
  )
}
