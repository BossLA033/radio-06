---
import type { CollectionEntry } from 'astro:content';
import { videosPublicados } from '../lib/conteudo';
import Imagem from './Imagem.astro';
import Secao from './Secao.astro';

function thumbDoVideo(video: CollectionEntry<'videos'>) {
  if (video.data.thumb) return video.data.thumb;
  if (video.data.origem === 'youtube') {
    const id = video.data.url.match(/(?:v=|youtu\.be\/)([\w-]{11})/)?.[1];
    if (id) return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
  }
  return undefined;
}

const videos = (await videosPublicados()).slice(0, 6);
---

{
  videos.length > 0 && (
    <Secao id="videos" titulo="Vídeos" href="/videos/" rotulo="Todos os vídeos">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map((video) => (
          <li>
            <a
              href={video.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              <div class="relative aspect-video overflow-hidden rounded-xl border border-borda bg-superficie">
                <Imagem src={thumbDoVideo(video)} alt={video.data.titulo} classe="size-full transition duration-300 group-hover:scale-105" emoji="🎬" />
                <span class="absolute inset-0 grid place-items-center bg-fundo/40 opacity-0 transition group-hover:opacity-100">
                  <span class="grid size-12 place-items-center rounded-full bg-acento text-fundo" aria-hidden="true">
                    ▶
                  </span>
                </span>
              </div>
              <h3 class="mt-3 text-sm font-bold group-hover:text-acento">{video.data.titulo}</h3>
            </a>
          </li>
        ))}
      </ul>
    </Secao>
  )
}
