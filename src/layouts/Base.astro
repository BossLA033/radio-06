---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlayerBar from '../components/PlayerBar.astro';
import { definicoes, programasVisiveis, slots } from '../lib/conteudo';
import '../styles/globals.css';

interface Props {
  titulo?: string;
  descricao?: string;
}

const d = await definicoes();
const grelha = await slots();
const programas = (await programasVisiveis()).map((programa) => ({
  id: programa.id,
  nome: programa.data.nome,
}));
const { titulo, descricao } = Astro.props;

const tituloCompleto = titulo ? `${titulo} — ${d.nome}` : `${d.nome} — ${d.slogan}`;
const descricaoFinal = descricao ?? `${d.nome} ${d.frequencia}. ${d.slogan}.`;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricaoFinal} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,800;0,900;1,600;1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-64.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{tituloCompleto}</title>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col pb-24">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[500] focus:rounded focus:bg-acento focus:px-4 focus:py-2 focus:text-fundo"
    >
      Saltar para o conteúdo
    </a>
    <Header />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />
    <PlayerBar />
    <div id="dados-do-site" hidden>
      <script
        type="application/json"
        set:html={JSON.stringify({ grelha, fuso: 'Africa/Luanda', programas })}
      />
    </div>
    <ClientRouter />
  </body>
</html>
