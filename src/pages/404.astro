---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada">
  <section class="mx-auto max-w-6xl px-4 py-24 text-center">
    <p class="text-sm font-bold uppercase tracking-widest text-acento">Erro 404</p>
    <h1 class="mt-3 text-4xl font-black">Página não encontrada</h1>
    <p class="mt-4 text-suave">
      O endereço que procuraste não existe ou mudou de lugar.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-acento px-6 py-3 font-semibold text-fundo transition hover:brightness-110"
    >
      Voltar ao início
    </a>
  </section>
</Base>
