---
import Base from '../layouts/Base.astro';
import ApresentadoresSecao from '../components/ApresentadoresSecao.astro';
import DestaquesSecao from '../components/DestaquesSecao.astro';
import EventosSecao from '../components/EventosSecao.astro';
import HomenagensSecao from '../components/HomenagensSecao.astro';
import NoticiasSecao from '../components/NoticiasSecao.astro';
import PassouSecao from '../components/PassouSecao.astro';
import PodcastsSecao from '../components/PodcastsSecao.astro';
import ProgramasSecao from '../components/ProgramasSecao.astro';
import PublicidadeSecao from '../components/PublicidadeSecao.astro';
import TopXSecao from '../components/TopXSecao.astro';
import VideosSecao from '../components/VideosSecao.astro';
---

<Base>
  <ProgramasSecao id="programas" variante="faixa" />
  <DestaquesSecao variante="grelha" id="em-destaque" />
  <NoticiasSecao />
  <PodcastsSecao />
  <PassouSecao />
  <VideosSecao />
  <HomenagensSecao />
  <TopXSecao />
  <ProgramasSecao id="tira" variante="tira" />
  <PublicidadeSecao indice={0} />
  <DestaquesSecao variante="carrossel" id="destaques" />
  <PublicidadeSecao indice={1} />
  <EventosSecao />
  <ApresentadoresSecao />
</Base>
