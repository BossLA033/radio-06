---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Imagem from '../../components/Imagem.astro';
import { noticiasPublicadas } from '../../lib/conteudo';
import { formatarDataLonga } from '../../lib/formatos';

export const getStaticPaths = (async () => {
  const noticias = await noticiasPublicadas();
  return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}) satisfies GetStaticPaths;

const { noticia } = Astro.props;
const { Content } = await render(noticia);
---

<Base titulo={noticia.data.titulo} descricao={noticia.data.resumo}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a href="/noticias/" class="text-sm text-suave hover:text-acento">← Todas as notícias</a>

    <p class="mt-6 text-xs uppercase tracking-wider text-acento">
      {noticia.data.tag} · {formatarDataLonga(noticia.data.data)}
    </p>
    <h1 class="mt-2 text-4xl font-black leading-tight">{noticia.data.titulo}</h1>

    {
      noticia.data.capa && (
        <div class="mt-6 aspect-video overflow-hidden rounded-xl border border-borda bg-superficie">
          <Imagem src={noticia.data.capa} alt={noticia.data.titulo} classe="size-full" />
        </div>
      )
    }

    <div class="prose-noticia mt-8">
      <Content />
    </div>

    {
      noticia.data.link && (
        <a
          href={noticia.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-block rounded-full bg-acento px-6 py-3 font-semibold text-fundo transition hover:brightness-110"
        >
          Ler no original ↗
        </a>
      )
    }
  </article>
</Base>
