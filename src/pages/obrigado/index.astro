---
import Base from '../../layouts/Base.astro';
---

<Base titulo="Mensagem enviada" descricao="Obrigado pela tua mensagem.">
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-6xl" aria-hidden="true">📻</p>
    <h1 class="mt-6 text-4xl font-black">Mensagem enviada</h1>
    <p class="mt-4 text-suave">Obrigado. Lêmos tudo e respondemos o mais rápido possível.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-acento px-6 py-3 font-semibold text-fundo transition hover:brightness-110"
    >
      Voltar ao início
    </a>
  </section>
</Base>
