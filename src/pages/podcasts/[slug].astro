---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Imagem from '../../components/Imagem.astro';
import { episodiosPublicos, podcastsPublicos } from '../../lib/conteudo';
import { formatarDataLonga } from '../../lib/formatos';

export const getStaticPaths = (async () => {
  const series = await podcastsPublicos();
  return series.map(({ serie }) => ({ params: { slug: serie.id }, props: { serie } }));
}) satisfies GetStaticPaths;

const { serie } = Astro.props;
const episodios = episodiosPublicos(serie);
---

<Base titulo={serie.data.titulo} descricao={serie.data.descricao}>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <a href="/podcasts/" class="text-sm text-suave hover:text-acento">← Todos os podcasts</a>

    <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-center">
      <div class="size-40 shrink-0 overflow-hidden rounded-xl border border-borda bg-superficie">
        <Imagem src={serie.data.imagem} alt={serie.data.titulo} classe="size-full" emoji="🎧" />
      </div>
      <div>
        <h1 class="text-3xl font-black leading-tight">{serie.data.titulo}</h1>
        <p class="mt-3 text-suave">{serie.data.descricao}</p>
      </div>
    </div>

    <ol class="mt-10 space-y-6">
      {
        episodios.map((episodio) => (
          <li class="rounded-xl border border-borda bg-superficie p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="font-bold">{episodio.titulo}</h2>
              <p class="text-xs text-suave">
                {formatarDataLonga(episodio.data)} · {episodio.duracao}
              </p>
            </div>
            <audio controls preload="none" class="mt-3 w-full" src={episodio.audio}>
              O teu navegador não suporta áudio.
              <a href={episodio.audio}>Descarregar episódio</a>
            </audio>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
