---
import Base from '../../layouts/Base.astro';
import Imagem from '../../components/Imagem.astro';
import { programasVisiveis } from '../../lib/conteudo';

const programas = await programasVisiveis();
---

<Base titulo="Programas" descricao="Todos os programas da grelha.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-black">Programas</h1>
    <p class="mt-2 text-suave">Conhece quem está no ar e quando.</p>

    {
      programas.length === 0 ? (
        <p class="mt-10 rounded-xl border border-borda bg-superficie p-8 text-center text-suave">
          Ainda não há programas publicados.
        </p>
      ) : (
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {programas.map((programa) => (
            <li class="overflow-hidden rounded-xl border border-borda bg-superficie transition hover:border-acento">
              <a href={`/programas/${programa.id}/`} class="block">
                <div class="aspect-video">
                  <Imagem src={programa.data.imagem} alt={programa.data.nome} classe="size-full" emoji="🎙️" />
                </div>
                <div class="p-5">
                  <p class="text-xs uppercase tracking-wider text-acento">{programa.data.horario}</p>
                  <h2 class="mt-1 text-lg font-black">{programa.data.nome}</h2>
                  <p class="mt-2 line-clamp-3 text-sm text-suave">{programa.data.descricao}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
