---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Imagem from '../../components/Imagem.astro';
import { videosPublicados } from '../../lib/conteudo';

function thumbDoVideo(video: CollectionEntry<'videos'>) {
  if (video.data.thumb) return video.data.thumb;
  if (video.data.origem === 'youtube') {
    const id = video.data.url.match(/(?:v=|youtu\.be\/)([\w-]{11})/)?.[1];
    if (id) return `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
  }
  return undefined;
}

const videos = await videosPublicados();
---

<Base titulo="Vídeos" descricao="Vídeos da emissora.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-black">Vídeos</h1>
    <p class="mt-2 text-suave">Tudo em imagem.</p>

    {
      videos.length === 0 ? (
        <p class="mt-10 rounded-xl border border-borda bg-superficie p-8 text-center text-suave">
          Ainda não há vídeos publicados.
        </p>
      ) : (
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {videos.map((video) => (
            <li>
              <a href={video.data.url} target="_blank" rel="noopener noreferrer" class="group block">
                <div class="relative aspect-video overflow-hidden rounded-xl border border-borda bg-superficie">
                  <Imagem
                    src={thumbDoVideo(video)}
                    alt={video.data.titulo}
                    classe="size-full transition duration-300 group-hover:scale-105"
                    emoji="🎬"
                  />
                  <span class="absolute inset-0 grid place-items-center bg-fundo/40 opacity-0 transition group-hover:opacity-100">
                    <span class="grid size-12 place-items-center rounded-full bg-acento text-fundo" aria-hidden="true">
                      ▶
                    </span>
                  </span>
                </div>
                <h2 class="mt-3 font-bold group-hover:text-acento">{video.data.titulo}</h2>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
